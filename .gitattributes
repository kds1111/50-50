# Unity text assets — force LF, treat as text so diffs and merges work
*.cs text diff=csharp
*.meta text
*.asset text
*.unity text
*.prefab text
*.mat text
*.anim text
*.controller text
*.overrideController text
*.physicMaterial text
*.physicsMaterial2D text
*.playable text
*.mask text
*.brush text
*.flare text
*.fontsettings text
*.guiskin text
*.giparams text
*.renderTexture text
*.spriteatlas text
*.terrainlayer text
*.mixer text
*.shadervariants text
*.preset text
*.asmdef text
*.asmref text
*.inputactions text
*.json text
*.md text
*.txt text
*.shader text
*.cginc text
*.hlsl text
*.compute text

# Binary assets — Git LFS. Added before the first binary lands; retrofitting
# LFS means rewriting history, so every type goes in now even if unused today.

# 3D models
*.fbx filter=lfs diff=lfs merge=lfs -text
*.FBX filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
